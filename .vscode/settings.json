{
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "files.exclude": {
        "__pycache__": true,
        ".venv": true,
        "build": true,
        ".cache": true,
        ".pytest_cache": true,
    },
    "cmake.configureArgs": [
        "-DPython_ROOT_DIR=${workspaceFolder}/.venv",
        "-DNO_OPTIONS_FILE=1",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
    ],
    "[cpp]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[cu]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[c]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[python]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    }
}
